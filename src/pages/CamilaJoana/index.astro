    <section class="w-full h-[90vh] md:h-[100vh] overflow-hidden bg-[#FEBCE4] flex items-center justify-center">

        <video autoplay muted playsinline poster="/AuroraInvitation/CamilaJoanaVideoPoster.png" class=" w-full h-full md:h-[100vh] md:w-auto object-cover object-center">
        
            <source src="CamilaJoanaVideo.webm" type="video/mp4" type="video/webm" />

            <source src="/AuroraInvitation/CamilaJoanaVideo_compressed.mp4" type="video/mp4" />
            
            Tu navegador no soporta videos.

        </video>

    </section>


  <Music
    audioUrl="/AuroraInvitation/EresTuElPrincipeAzul.mp3"
    textoMusica="¡Disfruta de la música de mi fiesta!"
    colorFondo="#FEBCE4"
    colorAcento="#E3027A"
    colorTexto="#E3027A"
  />

 <!-- seccion palabras/frase bonita -->

    <section class="relative w-full min-h-[50vh] bg-[url('/AuroraInvitation/PrincessAuroraBackground.webp')] bg-cover bg-center flex flex-col items-center justify-center p-5 overlay-dark ">

        <div  class="max-w-3xl text-center pt-10">
        <h2 class="text-3xl md:text-4 xl font-DancingScript text-[#ffffff] text-shadow-xs mb-6 animate-fade-in-up">
            “Como en los cuentos más hermosos, cada sueño tiene su momento para hacerse realidad.” <br/><br/>

            Hoy, al llegar a esta etapa tan especial de mi vida, deseo compartir contigo una noche llena de magia,y emociones inolvidables. <br/><br/>
                    
            Como la delicadeza de una rosa encantada y el brillo de un sueño cumplido, te invito a celebrar mis 15 años.
                    
            Será una noche para bailar, sonreír y crear recuerdos que permanecerán para siempre en nuestros corazones.
        </h2>
        </div>
    </section>

    <!-- Seccion Padres y niña -->

     <section class="w-full h-[100vh] overflow-hidden bg-[#FEBCE4] flex items-center justify-center">

        <img 
            src="/AuroraInvitation/SeccionPadres.webp" 
            alt="Padres e hija" 
            draggable="false"
            class="w-full h-full md:w-auto pointer-events-none select-none [-webkit-touch-callout:none]"
        />

     </section>



   <!-- <section class=" relative w-full min-h-[50vh] bg-linear-to-br from-pink-200 to-pink-300 bg-cover bg-center flex flex-col items-center justify-center p-5 ">

          <img 
            src="/AuroraInvitation/FlowerCorner.webp" 
            alt="Decoración 1" 
            class="absolute top-0 left-0 w-60 md:w-80"
        />

