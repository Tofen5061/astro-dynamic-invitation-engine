    <!-- Seccion Ubicacion -->

    <section class=" bg-[#ffe0f1] w-full py-10 flex flex-col items-center justify-center">

        <img 
            src="/AuroraInvitation/ubicacionIcon.webp" 
            alt="ubicacion" 
            class="w-15 md:w-25 "
        />

        <h2 class="text-5xl md:text-4xl font-DancingScript text-[#000000] text-shadow-xs mt-5 text-center   ">
                Lugar del Evento
        </h2>   

         <h2 class="text-2xl mt-5 text-center text-[#E3027A] text-shadow-sm p-5 font-aboreto font-bold">Planta baja de Dilectus discoteque, Chinandega</h2>

         <h2 class="text-5xl md:text-4xl font-DancingScript text-[#E3027A] text-shadow-xs mt-5 mb-10">
                6:30 PM
         </h2>


        <LinkButton 
            url="https://www.google.com/maps/place/Dilectus/@12.6193956,-87.1141251,16.5z/data=!4m6!3m5!1s0x8f70f1c5191f1c31:0x2d83808018877848!8m2!3d12.6191224!4d-87.1144617!16s%2Fg%2F1ptxz3kzc?entry=ttu&g_ep=EgoyMDI2MDYwOS4wIKXMDSoASAFQAw%3D%3D"
            buttonText="Ir a Google Maps"
        />
    </section>

    <!-- Seccion Vestimenta -->

    <section class="bg-[#ffe0f1] w-full py-10 flex flex-col items-center justify-center">
        <h2 class="text-5xl md:text-4xl text-center font-DancingScript text-[#E3027A] text-shadow-xs mb-10">
                Código de Vestimenta
        </h2>

        <img 
            src="/AuroraInvitation/CodigoVestimenta-Photoroom.webp" 
            alt="dress code" 
            class="w-85 border-1 border-[#4a0027]  p-2"
        />

        <h2 class="text-2xl mt-5 text-center text-[#b8005f] text-shadow-sm p-5 font-aboreto font-bold">Formal - Elegante</h2>
        
        <h2 class="text-2xl mt-2 text-center text-[#b8005f] text-shadow-sm p-5 font-aboreto font-extrabold">Colores Permitidos: <br> <span class="font-bold text-[#000000]">Negro</span>,<span class="font-bold text-[#2100b3]"> Azul</span>, <span class="font-bold text-[#D3AC7B]"> Beige</span></h2>

        <h2 class="text-2xl mt-2 text-center text-[#b8005f] text-shadow-sm p-5 font-aboreto font-extrabold">Colores Prohibidos: <br> <br> <span class="font-bold text-[#ff009d] bg-white p-5 rounded-full">Rosa</span></h2>
           
        
        <div class="w-85 h-85  border-1 border-[#4a0027] p-5 mt-3 bg-white ">
            <img 
            src="/AuroraInvitation/ProhibitedColor.png" 
            alt="dress code" 
            class="w-full h-full object-cover object-center"
        />
        </div>
        
    </section>

    <Timer 
        dateText=""
        targetDate="2026-07-04T18:30:00"
        backgroundTimerSrc="/CloudWallpaper.jpeg"
        colorFondo="#FEA9D7"
        colorTexto="#f7319b"
        colorAcento="#f7319b"
        esModoOscuro={false}
    />

     <Calendar 
        fechaEvento="2026-07-04T18:30:00"
        {...paletaCalendario}
    />

    
 

    <!-- seccion muestra de cariño en sobre -->

    <section class="bg-[#ffe0f1] w-full py-10 flex flex-col items-center justify-center">


        <h2 class="text-5xl md:text-4xl font-DancingScript text-[#f7319b] text-shadow-xs text-center   ">
                Muestras de Cariño <br>
                <span class="text-[#82094a]">En Sobre</span>
        </h2> 


            <img 
                src="/AuroraInvitation/SobreAurora-Photoroom.webp" 
                alt="dress code" 
                class="w-75 h-auto"
            />

    </section>

    <!-- Seccion Confirmar Asistencia -->

    <section class="bg-[#ffe0f1] w-full py-10 flex flex-col items-center justify-center">

        <h2 class="text-5xl md:text-4xl font-DancingScript text-[#E3027A] text-shadow-xs mb-10">
                Confirmar Asistencia
        </h2>

        <img 
            src="/charla-telefonica-unscreen.gif" 
            alt="confirmacion" 
            class="w-40"
        />

         <h2 class="text-3xl md:text-4xl font-DancingScript text-[#000000] text-shadow-xs mt-5 text-center   ">
                ¡Tu presencia es muy importante para mí!
        </h2>   

         <h2 class="text-xl mt-5 text-center text-[#ca0068] p-5 font-aboreto font-bold">Por favor confirma tu asistencia a continuación</h2>

         <LinkButton 
            url="https://wa.me/50576716403?text=¡Hola!%20Quiero%20confirmar%20mi%20asistencia%20a%20los%2015%20años%20de%20Camila%20Joana.%20¡Estoy%20emocionado/a%20por%20celebrar%20este%20día%20tan%20especial!"
            buttonText="Confirmar Asistencia"
        />

	</section>

    <!-- Seccion Agradecimientos -->

    <section class="bg-[#ffe0f1] w-full py-10 flex flex-col items-center justify-center" >

        <div class="w-full h-auto flex flex-col md:flex-row justify-center items-center md:items-start">

            <img src="/AuroraInvitation/Aurora2-Photoroom.webp"
                alt="Agradecimientos Aurora" 
                class="w-80 h-auto"
            />

            <h2 class="text-3xl md:text-4xl font-DancingScript text-[#E3027A] text-shadow-xs mt-5 text-center">
                Tu presencia hará que esta historia sea aún más especial… <br/><br/>

                <span class="text-4xl md:text-5xl text-[#57002f] text-shadow-xs">
                    Con cariño,<br/><br/>
                </span>

                <span class="text-5xl md:text-6xl font-DancingScript leading-relaxed text-[#FF1493] font-bold  drop-shadow-xs  animate-fade-in-up">💕 {nombreQuinceañera} 💕</span>
            </h2>

        </div>






    </section>




</Layout>