---
interface Props {
  DateText?: string;
  TargetDate?: string;
  BackgroundTimerSrc?: string;
}

const {
  DateText = "",
  TargetDate = "2000-01-01T00:00:00",
  BackgroundTimerSrc = "",
} = Astro.props;
---

<div class="Timer">
  <h1 class="fecha">{DateText}</h1>
  <h1 id="FechaFaltan">Faltan</h1>
  <p class="temporizador">
    <span id="Dias">0</span> :
    <span id="Horas">0</span> :
    <span id="Minutos">0</span> :
    <span id="Segundos">0</span>
  </p>

  <div class="temporizador_detalles">
    <p id="DiasDetalles">Dias</p>
    <p id="HorasDetalles">Horas</p>
    <p id="MinutosDetalles">Min</p>
    <p id="SegundosDetalles">Seg</p>
  </div>
</div>

<style
  define:vars={{
    BackgroundImage: BackgroundTimerSrc
      ? `url('${BackgroundTimerSrc}')`
      : "none",
  }}
>
  .Timer {
    text-align: center;
    background-image: var(--BackgroundImage);
    background-size: cover;
    background-position: center;
    min-height: 20vh;
    padding: 1rem;
    padding-top: 30%;
    padding-bottom: 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .Timer h1,
  .Timer p {
    margin: 0;
    padding: 0;
  }

  .fecha {
    font-family: "Bodoni Moda Variable", serif;
    padding-top: 1rem;
    font-size: 2rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  #FechaFaltan {
    font-family: "Dancing Script", cursive;
    font-size: 2rem;
    margin-top: 1rem;
  }

  .temporizador {
    font-size: 3rem;
    font-family: "Dancing Script", cursive;
  }

  .temporizador_detalles {
    position: relative;
    right: 0.5rem;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    font-size: 2rem;
    font-family: "Dancing Script", cursive;
  }

  #SegundosDetalles {
    margin-left: 0.2rem;
  }

  @media (min-width: 768px) {
    .Timer {
      padding-top: 5%;
      padding-bottom: 5%;
    }
  }
</style>

<script define:vars={{ TargetDate }}>
  const FechaObjetivo = new Date(TargetDate).getTime();

  const ActualizarTemporizador = () => {
    const Ahora = new Date().getTime();
    const Diferencia = FechaObjetivo - Ahora;

    // Cálculos
    const DiasCalculados = Math.floor(Diferencia / (1000 * 60 * 60 * 24));
    const HorasCalculadas = Math.floor(
      (Diferencia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
    );
    const MinutosCalculados = Math.floor((Diferencia % (1000 * 60 * 60)) / (1000 * 60));
    const SegundosCalculados = Math.floor((Diferencia % (1000 * 60)) / 1000);

    // Actualizar con seguridad (verificando que existan y convirtiendo a String)
    const EstablecerElemento = (Id, Val) => {
      const Elemento = document.getElementById(Id);
      if (Elemento) Elemento.textContent = String(Math.max(0, Val)).padStart(2, "0");
    };

    if (Diferencia > 0) {
      EstablecerElemento("Dias", DiasCalculados);
      EstablecerElemento("Horas", HorasCalculadas);
      EstablecerElemento("Minutos", MinutosCalculados);
      EstablecerElemento("Segundos", SegundosCalculados);
    } else {
      EstablecerElemento("Dias", 0);
      EstablecerElemento("Horas", 0);
      EstablecerElemento("Minutos", 0);
      EstablecerElemento("Segundos", 0);
    }
  };

  // Ejecutar cada segundo
  setInterval(ActualizarTemporizador, 1000);
  ActualizarTemporizador(); // Ejecutar una vez al inicio para evitar el salto de 0 a la fecha
</script>
