---
//SeccionMusica.astro
const {
  audioUrl = "/CancionBoda.mp3",
  textoMusica = "Nuestra Canción",
  colorComponente = "bg-[#DE3110]", // Recibimos la clase completa (sobreescribible)
} = Astro.props;
---

<section
  id="seccionMusica"
  class={`relative z-0 overflow-hidden flex flex-col items-center py-12 px-6 w-full ${colorComponente}`}
>
  <!-- Overlay blanco para suavizar el color de fondo -->
  <div class="absolute inset-0 bg-white/90 -z-10"></div>

  <h3
    id="textoInspirador"
    class="font-DancingScript text-4xl text-gray-800 mb-8 text-center"
  >
    {textoMusica}
  </h3>

  <div
    id="reproductorCustom"
    class="w-full max-w-lg flex flex-col items-center gap-6"
  >
    <audio id="audioElemento" preload="none">
      <source src={audioUrl} type="audio/mpeg" />
    </audio>

    <button
      id="botonReproduccion"
      class={`w-20 h-20 ${colorComponente} rounded-full flex items-center justify-center text-white shadow-md hover:brightness-90 transition-all active:scale-90`}
    >
      <svg
        id="iconoPlay"
        xmlns="http://www.w3.org/2000/svg"
        class="w-10 h-10 fill-current"
        viewBox="0 0 24 24"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg
        id="iconoPause"
        xmlns="http://www.w3.org/2000/svg"
        class="w-10 h-10 fill-current hidden"
        viewBox="0 0 24 24"
      >
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
      </svg>
    </button>

    <div id="contenedorProgreso" class="w-full space-y-2">
      <div
        id="barraProgresoBase"
        class="relative w-full h-1 bg-gray-100 rounded-full cursor-pointer"
      >
        <div
          id="barraProgresoActiva"
          class={`absolute top-0 left-0 h-full ${colorComponente} w-0 pointer-events-none`}
        >
        </div>
      </div>

      <div
        class="flex justify-between text-[10px] text-gray-400 font-sans tracking-[0.2em] uppercase"
      >
        <span id="tiempoActual">0:00</span>
        <span id="tiempoTotal">0:00</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Selección de elementos usando camelCase
  const audioElemento = document.getElementById(
    "audioElemento"
  ) as HTMLAudioElement;
  const botonReproduccion = document.getElementById("botonReproduccion");
  const iconoPlay = document.getElementById("iconoPlay");
  const iconoPause = document.getElementById("iconoPause");
  const barraProgresoActiva = document.getElementById("barraProgresoActiva");
  const barraProgresoBase = document.getElementById("barraProgresoBase");
  const tiempoActual = document.getElementById("tiempoActual");
  const tiempoTotal = document.getElementById("tiempoTotal");

  const alternarEstadoIconos = (estaPausado: boolean) => {
    if (estaPausado) {
      iconoPlay?.classList.remove("hidden");
      iconoPause?.classList.add("hidden");
    } else {
      iconoPlay?.classList.add("hidden");
      iconoPause?.classList.remove("hidden");
    }
  };

  botonReproduccion?.addEventListener("click", () => {
    if (audioElemento.paused) {
      audioElemento.play();
      alternarEstadoIconos(false);
    } else {
      audioElemento.pause();
      alternarEstadoIconos(true);
    }
  });

  audioElemento.addEventListener("timeupdate", () => {
    const porcentaje =
      (audioElemento.currentTime / audioElemento.duration) * 100;
    if (barraProgresoActiva) barraProgresoActiva.style.width = `${porcentaje}%`;

    const minutos = Math.floor(audioElemento.currentTime / 60);
    const segundos = Math.floor(audioElemento.currentTime % 60);
    if (tiempoActual)
      tiempoActual.textContent = `${minutos}:${segundos.toString().padStart(
        2,
        "0"
      )}`;
  });

  audioElemento.addEventListener("loadedmetadata", () => {
    const minutos = Math.floor(audioElemento.duration / 60);
    const segundos = Math.floor(audioElemento.duration % 60);
    if (tiempoTotal)
      tiempoTotal.textContent = `${minutos}:${segundos.toString().padStart(
        2,
        "0"
      )}`;
  });

  barraProgresoBase?.addEventListener("click", (evento) => {
    const rectangulo = barraProgresoBase.getBoundingClientRect();
    const posicionX = (evento as MouseEvent).clientX - rectangulo.left;
    const anchoTotal = rectangulo.width;
    const nuevoTiempo = (posicionX / anchoTotal) * audioElemento.duration;
    audioElemento.currentTime = nuevoTiempo;
  });

  audioElemento.addEventListener("ended", () => alternarEstadoIconos(true));
</script>
