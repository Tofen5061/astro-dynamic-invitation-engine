---
// src/components/LocationButton.astro

interface Props {
  url: string;
  buttonText: string;
}

const { url, buttonText } = Astro.props;
---


<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center px-5 py-5 bg-[#E3027A] text-white font-bold rounded-full shadow-lg hover:bg-[#ffffff] hover:text-[#E3027A] hover:scale-105 transition-all duration-300 active:scale-95"
>

<span class="text-2xl tracking-wide font-DancingScript">{buttonText}</span>

</a>