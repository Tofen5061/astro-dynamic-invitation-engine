---
// src/components/CalendarioEvento.astro

interface Props {
  fechaEvento: string;
  fondoPrincipal?: string;
  fondoSecundario?: string;
  fondoTerciario?: string;
  bordeSutil?: string;
  bordeFuerte?: string;
  acentoPrincipal?: string;
  acentoHover?: string;
  textoPrincipal?: string;
  textoSecundario?: string;
  textoAcento?: string;
}

const {
  fechaEvento,
  fondoPrincipal,
  fondoSecundario,
  fondoTerciario,
  bordeSutil,
  bordeFuerte,
  acentoPrincipal,
  acentoHover,
  textoPrincipal,
  textoSecundario,
  textoAcento,
} = Astro.props;

const dateObj = new Date(fechaEvento);
const eventYear = dateObj.getFullYear();
const eventMonth = dateObj.getMonth();
const eventDay = dateObj.getDate();

const daysInMonth = new Date(eventYear, eventMonth + 1, 0).getDate();
const firstDayOfWeek = new Date(eventYear, eventMonth, 1).getDay();

const emptyDays = Array.from({ length: firstDayOfWeek });
const days = Array.from({ length: daysInMonth }, (_, index) => index + 1);

const weekDays = ["D", "L", "M", "M", "J", "V", "S"];
const monthNames = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];
---

<div
  class="contenedor-calendario mx-auto flex flex-col items-center w-full p-4"
>
  <h3
    class="titulo-fecha text-3xl font-bold uppercase font-DancingScript tracking-widest w-full text-center mb-8 transition-colors duration-500 text-shadow-md"
  >
    {eventDay} de {monthNames[eventMonth]} de {eventYear}
  </h3>

  <div
    class="tarjeta-calendario max-w-xs rounded-2xl p-6 shadow-2xl border-3 transition-all duration-500"
  >
    <div class="text-center mb-6">
      <h3
        class="titulo-mes text-xl font-bold tracking-widest uppercase transition-colors duration-300"
      >
        {monthNames[eventMonth]}
        {eventYear}
      </h3>
    </div>

    <div class="grid grid-cols-7 gap-2 text-center text-sm">
      {
        weekDays.map((day) => (
          <div class="dia-cabecera font-semibold mb-2">{day}</div>
        ))
      }

      {emptyDays.map(() => <div class="w-9 h-9" />)}

      {
        days.map((day) => {
          const isEventDay = day === eventDay;
          return (
            <div class="flex justify-center items-center">
              <span
                class={`dia-celda flex items-center justify-center w-9 h-9 rounded-xl text-sm font-medium transition-all duration-300 ${isEventDay ? "dia-evento font-bold tracking-tight shadow-lg" : "dia-comun"}`}
              >
                {day}
              </span>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<style
  define:vars={{
    fondoPrincipal,
    fondoSecundario,
    fondoTerciario,
    bordeSutil,
    bordeFuerte,
    acentoPrincipal,
    acentoHover,
    textoPrincipal,
    textoSecundario,
    textoAcento,
  }}
>
  .contenedor-calendario {
    background-color: var(--fondoSecundario);
  }

  .titulo-fecha {
    color: var(--acentoPrincipal);
  }

  .tarjeta-calendario {
    background-color: var(--fondoPrincipal);
    border-color: var(--bordeFuerte);
  }

  .titulo-mes {
    color: var(--textoPrincipal);
  }

  .dia-cabecera {
    color: var(--textoSecundario);
  }

  .dia-celda {
    /* Estilos base */
  }

  .dia-comun {
    color: var(--textoSecundario);
  }

  .dia-comun:hover {
    background-color: var(--fondoTerciario);
    color: var(--textoPrincipal);
  }

  .dia-evento {
    background-color: var(--acentoPrincipal);
    color: var(--textoAcento);
    box-shadow: 0 10px 15px -3px var(--acentoPrincipal);
  }

  .dia-evento:hover {
    background-color: var(--acentoHover);
  }
</style>
